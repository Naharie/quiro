<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <LangVersion>preview</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Dictionary.fs" />
        <Compile Include="ActivePatterns.fs" />
        <Compile Include="Map.fs" />
        <Compile Include="Seq.fs" />
        <Compile Include="AST.fs" />
        <Compile Include="Term.fs" />
        <Compile Include="StackFrame.fs" />
        <Compile Include="PrologException.fs" />
        <Compile Include="InterpreterContext.fs" />
        <Compile Include="Parser.Internal.fs" />
        <Compile Include="Parser.fs" />
        <Compile Include="Interpreter.Internal.fs" />
        <Compile Include="Interpreter.fs" />
        <Compile Include="TermHelpers.fs" />
        <Compile Include="MetaTerms.fs" />
        <Compile Include="CoreTerms.fs" />
        <Compile Include="MathTerms.fs" />
        <Compile Include="ReflectionTerms.fs" />
        <Compile Include="ListTerms.fs" />
        <Compile Include="IOTerms.fs" />
        <Compile Include="BuiltinTerms.fs" />
        <Compile Include="Program.fs"/>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="FParsec" Version="2.0.0-beta2" />
    </ItemGroup>

</Project>
